// Telecom Service Support System - Database Schema
// SIM Activation Workflow Design for MySQL

Project telecom_support_system {
  database_type: 'MySQL'
  Note: 'Telecom Service Support System for SIM Activation Workflow'
}

// Core Entities

Table customers {
  id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [unique, not null]
  phone varchar(20) [not null]
  date_of_birth date [not null]
  created_at timestamp [default: `now()`]
  
  indexes {
    email [unique]
    phone
  }
  
  Note: 'Customer information for SIM activation'
}

Table sim_cards {
  id int [pk, increment]
  iccid varchar(20) [unique, not null]
  puk_code varchar(8) [not null]
  pin_code varchar(4) [not null]
  status enum('available', 'assigned', 'active') [default: 'available']
  created_at timestamp [default: `now()`]
  
  indexes {
    iccid [unique]
    status
  }
  
  Note: 'Physical SIM card details'
}

Table mobile_numbers {
  id int [pk, increment]
  number varchar(15) [unique, not null]
  status enum('available', 'assigned') [default: 'available']
  created_at timestamp [default: `now()`]
  
  indexes {
    number [unique]
    status
  }
  
  Note: 'Available mobile numbers for assignment'
}

Table document_types {
  id int [pk, increment]
  name varchar(100) [not null]
  code varchar(20) [unique, not null]
  is_required boolean [default: true]
  
  indexes {
    code [unique]
  }
  
  Note: 'Types of identity documents accepted'
}

Table customer_documents {
  id int [pk, increment]
  customer_id int [ref: > customers.id, not null]
  document_type_id int [ref: > document_types.id, not null]
  document_number varchar(100) [not null]
  file_path varchar(500)
  verification_status enum('pending', 'verified', 'rejected') [default: 'pending']
  verified_at timestamp
  verified_by varchar(100)
  rejection_reason text
  regulatory_check_passed boolean [default: false]
  compliance_notes text
  created_at timestamp [default: `now()`]
  
  indexes {
    customer_id
    verification_status
    regulatory_check_passed
    (customer_id, document_type_id) [unique]
  }
  
  Note: 'Customer identity documents with regulatory validation'
}

Table sim_activations {
  id int [pk, increment]
  customer_id int [ref: > customers.id, not null]
  sim_card_id int [ref: - sim_cards.id, not null, unique]
  mobile_number_id int [ref: - mobile_numbers.id, not null, unique]
  status enum('pending', 'verified', 'activated', 'rejected') [default: 'pending']
  request_date timestamp [default: `now()`]
  activation_date timestamp
  rejection_reason text
  processed_by varchar(100)
  process_notes text
  last_status_change timestamp [default: `now()`]
  created_at timestamp [default: `now()`]
  
  indexes {
    customer_id
    sim_card_id [unique]
    mobile_number_id [unique]
    status
    last_status_change
  }
  
  Note: 'SIM activation requests with one-to-one relationships to SIM cards and mobile numbers'
}

Table users {
  id int [pk, increment]
  username varchar(100) [unique, not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  role enum('admin', 'operator', 'supervisor') [not null]
  is_active boolean [default: true]
  last_login timestamp [null]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP`]
  
  Note: 'System users for processing activations'
}

Table activation_audit_log {
  id int [pk, increment]
  activation_id int [ref: > sim_activations.id]
  user_id int [ref: > users.id]
  action varchar(100) [not null]
  old_status varchar(50)
  new_status varchar(50)
  comments text
  ip_address varchar(45)
  user_agent text
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  
  Note: 'Audit trail for activation process changes'
}

Table regulatory_rules {
  id int [pk, increment]
  rule_name varchar(200) [not null]
  rule_code varchar(50) [unique, not null]
  description text
  validation_logic text
  is_active boolean [default: true]
  country_code varchar(5)
  effective_date date [not null]
  expiry_date date
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP`]
  
  Note: 'Regulatory compliance rules for document validation'
}

Table document_validations {
  id int [pk, increment]
  customer_document_id int [ref: > customer_documents.id]
  regulatory_rule_id int [ref: > regulatory_rules.id]
  validation_status enum('pending', 'passed', 'failed') [default: 'pending']
  validation_result text
  validated_at timestamp [null]
  validated_by int [ref: > users.id]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  
  Note: 'Individual document validation against regulatory rules'
}

