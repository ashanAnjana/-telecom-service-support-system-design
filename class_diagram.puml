@startuml


class Customer {
    -int id
    -string firstName
    -string lastName
    -string email
    -string phone
    -DateTime dateOfBirth
    -DateTime createdAt
    +__construct(firstName, lastName, email, dateOfBirth)
    +getId() : int
    +getFullName() : string
    +getEmail() : string
    +isEligibleForActivation() : bool
}

class SimCard {
    -int id
    -string iccid
    -string pukCode
    -string pinCode
    -SimStatus status
    -DateTime createdAt
    +__construct(iccid, pukCode, pinCode)
    +getId() : int
    +getIccid() : string
    +isAvailable() : bool
    +activate() : void
    +getStatus() : SimStatus
}

class MobileNumber {
    -int id
    -string number
    -NumberStatus status
    -DateTime createdAt
    +__construct(number)
    +getId() : int
    +getNumber() : string
    +isAvailable() : bool
    +assign() : void
}

class DocumentType {
    -int id
    -string name
    -string code
    -bool isRequired
    +__construct(name, code, isRequired)
    +getId() : int
    +getName() : string
    +getCode() : string
    +isRequired() : bool
}

class CustomerDocument {
    -int id
    -int customerId
    -int documentTypeId
    -string documentNumber
    -string filePath
    -VerificationStatus verificationStatus
    -DateTime verifiedAt
    -string verifiedBy
    -string rejectionReason
    -bool regulatoryCheckPassed
    -string complianceNotes
    -DateTime createdAt
    +__construct(customerId, documentTypeId, documentNumber)
    +getId() : int
    +getDocumentNumber() : string
    +verify(string verifiedBy) : void
    +reject(string reason, string verifiedBy) : void
    +getVerificationStatus() : VerificationStatus
    +performRegulatoryCheck() : bool
    +isCompliant() : bool
}

class SimActivation {
    -int id
    -int customerId
    -int simCardId
    -int mobileNumberId
    -ActivationStatus status
    -DateTime requestDate
    -DateTime activationDate
    -string rejectionReason
    -string processedBy
    -string processNotes
    -DateTime lastStatusChange
    -DateTime createdAt
    +__construct(customerId, simCardId, mobileNumberId)
    +getId() : int
    +processActivation(string processedBy) : void
    +activate(string processedBy) : void
    +reject(string reason, string processedBy) : void
    +getStatus() : ActivationStatus
    +validateDocuments() : bool
    +addAuditNote(string note, string processedBy) : void
    +getAuditTrail() : string
}

' Service Class
class ActivationService {
    +initiateActivation(customerId, simCardId, mobileNumberId) : SimActivation
    +processActivation(activationId, string processedBy) : bool
    +validateDocuments(customerId) : bool
    +performRegulatoryCompliance(customerId) : bool
    +activateSim(activationId, string processedBy) : bool
    +getActivationAuditTrail(activationId) : array
}

' Enumerations
enum SimStatus {
    AVAILABLE
    ASSIGNED
    ACTIVE
}

enum NumberStatus {
    AVAILABLE
    ASSIGNED
}

enum ActivationStatus {
    PENDING
    VERIFIED
    ACTIVATED
    REJECTED
}

enum VerificationStatus {
    PENDING
    VERIFIED
    REJECTED
}

' Relationships
Customer ||--o{ CustomerDocument : has
Customer ||--o{ SimActivation : requests
DocumentType ||--o{ CustomerDocument : defines
SimCard ||--|| SimActivation : uses
MobileNumber ||--|| SimActivation : uses

' Service Dependencies
ActivationService ..> Customer : manages
ActivationService ..> SimCard : assigns
ActivationService ..> MobileNumber : assigns
ActivationService ..> SimActivation : processes
ActivationService ..> CustomerDocument : validates

@enduml
