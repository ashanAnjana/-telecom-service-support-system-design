classDiagram
    %% Telecom Service Support System - Class Diagram
    %% Object-Oriented Design for SIM Activation Workflow (PHP)

    class Customer {
        -int id
        -string firstName
        -string lastName
        -string email
        -string phone
        -DateTime dateOfBirth
        -string address
        -DateTime createdAt
        -DateTime updatedAt
        +__construct(firstName, lastName, email, dateOfBirth)
        +getId() int
        +getFullName() string
        +getEmail() string
        +addDocument(Document document) void
        +getDocuments() array
        +isEligibleForActivation() bool
        +validateAge() bool
    }

    class SimCard {
        -int id
        -string iccid
        -string imsi
        -string pukCode
        -string pinCode
        -SimStatus status
        -string batchNumber
        -DateTime manufacturedDate
        -DateTime createdAt
        -DateTime updatedAt
        +__construct(iccid, pukCode, pinCode)
        +getId() int
        +getIccid() string
        +isAvailable() bool
        +activate() void
        +suspend() void
        +terminate() void
        +getStatus() SimStatus
        +setStatus(SimStatus status) void
    }

    class MobileNumber {
        -int id
        -string number
        -string countryCode
        -string areaCode
        -NumberStatus status
        -NumberType type
        -DateTime createdAt
        -DateTime updatedAt
        +__construct(number, countryCode, type)
        +getId() int
        +getNumber() string
        +isAvailable() bool
        +assign() void
        +release() void
        +getFormattedNumber() string
        +validateFormat() bool
    }

    class DocumentType {
        -int id
        -string name
        -string code
        -string description
        -bool isMandatory
        -string regulatoryRequirement
        -DateTime createdAt
        +__construct(name, code, isMandatory)
        +getId() int
        +getName() string
        +getCode() string
        +isMandatory() bool
        +getRegulatoryRequirement() string
    }

    class CustomerDocument {
        -int id
        -int customerId
        -int documentTypeId
        -string documentNumber
        -string documentFilePath
        -DateTime issueDate
        -DateTime expiryDate
        -string issuingAuthority
        -VerificationStatus verificationStatus
        -DateTime verifiedAt
        -int verifiedBy
        -string rejectionReason
        -DateTime createdAt
        -DateTime updatedAt
        +__construct(customerId, documentTypeId, documentNumber)
        +getId() int
        +getDocumentNumber() string
        +isExpired() bool
        +verify(User user) void
        +reject(User user, string reason) void
        +getVerificationStatus() VerificationStatus
        +uploadFile(string filePath) void
    }

    class SimActivation {
        -int id
        -int customerId
        -int simCardId
        -int mobileNumberId
        -ActivationStatus activationStatus
        -DateTime requestDate
        -DateTime activationDate
        -int processedBy
        -string rejectionReason
        -RegulatoryStatus regulatoryCheckStatus
        -DateTime regulatoryCheckDate
        -string notes
        -DateTime createdAt
        -DateTime updatedAt
        +__construct(customerId, simCardId, mobileNumberId)
        +getId() int
        +processActivation(User user) void
        +approve(User user) void
        +reject(User user, string reason) void
        +activate() void
        +getStatus() ActivationStatus
        +validateDocuments() bool
        +performRegulatoryCheck() bool
        +addAuditLog(string action, User user) void
    }

    class User {
        -int id
        -string username
        -string email
        -string passwordHash
        -string firstName
        -string lastName
        -UserRole role
        -bool isActive
        -DateTime lastLogin
        -DateTime createdAt
        -DateTime updatedAt
        +__construct(username, email, firstName, lastName, role)
        +getId() int
        +getUsername() string
        +authenticate(string password) bool
        +hasPermission(string permission) bool
        +canProcessActivation() bool
        +canVerifyDocuments() bool
        +updateLastLogin() void
    }

    class RegulatoryRule {
        -int id
        -string ruleName
        -string ruleCode
        -string description
        -string validationLogic
        -bool isActive
        -string countryCode
        -DateTime effectiveDate
        -DateTime expiryDate
        -DateTime createdAt
        -DateTime updatedAt
        +__construct(ruleName, ruleCode, validationLogic)
        +getId() int
        +getRuleName() string
        +isActive() bool
        +isEffective() bool
        +validateDocument(CustomerDocument document) ValidationResult
        +getValidationLogic() string
    }

    class DocumentValidation {
        -int id
        -int customerDocumentId
        -int regulatoryRuleId
        -ValidationStatus validationStatus
        -string validationResult
        -DateTime validatedAt
        -int validatedBy
        -DateTime createdAt
        +__construct(customerDocumentId, regulatoryRuleId)
        +getId() int
        +validate(User user) ValidationResult
        +getStatus() ValidationStatus
        +getResult() string
        +isPassed() bool
    }

    class ActivationAuditLog {
        -int id
        -int activationId
        -int userId
        -string action
        -string oldStatus
        -string newStatus
        -string comments
        -string ipAddress
        -string userAgent
        -DateTime createdAt
        +__construct(activationId, userId, action)
        +getId() int
        +getAction() string
        +getTimestamp() DateTime
        +getComments() string
        +logStatusChange(string oldStatus, string newStatus) void
    }

    %% Service Classes for Business Logic
    class SimActivationService {
        -CustomerRepository customerRepo
        -SimCardRepository simRepo
        -MobileNumberRepository numberRepo
        -DocumentValidationService docValidationService
        -RegulatoryComplianceService regulatoryService
        -AuditService auditService
        +__construct(repositories, services)
        +initiateActivation(customerId, simCardId, mobileNumberId) SimActivation
        +processActivationRequest(activationId, userId) bool
        +validateCustomerDocuments(customerId) bool
        +performRegulatoryChecks(activationId) bool
        +activateSim(activationId, userId) bool
        +rejectActivation(activationId, userId, reason) bool
    }

    class DocumentValidationService {
        -RegulatoryRuleRepository ruleRepo
        -DocumentValidationRepository validationRepo
        +__construct(repositories)
        +validateDocument(CustomerDocument document) ValidationResult
        +validateAllDocuments(customerId) bool
        +getRegulatoryRules(documentType) array
        +performValidation(document, rule) ValidationResult
    }

    class RegulatoryComplianceService {
        -RegulatoryRuleRepository ruleRepo
        +__construct(ruleRepo)
        +checkCompliance(SimActivation activation) bool
        +validateAgainstRules(documents) bool
        +getApplicableRules(countryCode) array
        +isCompliant(validationResults) bool
    }

    class AuditService {
        -ActivationAuditLogRepository auditRepo
        +__construct(auditRepo)
        +logAction(activationId, userId, action, comments) void
        +logStatusChange(activationId, userId, oldStatus, newStatus) void
        +getAuditTrail(activationId) array
        +generateComplianceReport() array
    }

    %% Enums
    class SimStatus {
        <<enumeration>>
        INACTIVE
        ACTIVE
        SUSPENDED
        TERMINATED
    }

    class NumberStatus {
        <<enumeration>>
        AVAILABLE
        ASSIGNED
        RESERVED
        BLOCKED
    }

    class NumberType {
        <<enumeration>>
        PREPAID
        POSTPAID
    }

    class ActivationStatus {
        <<enumeration>>
        PENDING
        DOCUMENT_VERIFICATION
        APPROVED
        ACTIVATED
        REJECTED
    }

    class VerificationStatus {
        <<enumeration>>
        PENDING
        VERIFIED
        REJECTED
        EXPIRED
    }

    class ValidationStatus {
        <<enumeration>>
        PENDING
        PASSED
        FAILED
    }

    class RegulatoryStatus {
        <<enumeration>>
        PENDING
        PASSED
        FAILED
    }

    class UserRole {
        <<enumeration>>
        ADMIN
        OPERATOR
        SUPERVISOR
    }

    class ValidationResult {
        -bool isValid
        -string message
        -array errors
        +__construct(isValid, message)
        +isValid() bool
        +getMessage() string
        +getErrors() array
        +addError(string error) void
    }

    %% Relationships
    Customer ||--o{ CustomerDocument : "has"
    Customer ||--o{ SimActivation : "requests"
    
    DocumentType ||--o{ CustomerDocument : "defines"
    
    SimCard ||--o{ SimActivation : "assigned to"
    MobileNumber ||--o{ SimActivation : "assigned to"
    
    User ||--o{ SimActivation : "processes"
    User ||--o{ CustomerDocument : "verifies"
    User ||--o{ ActivationAuditLog : "creates"
    
    SimActivation ||--o{ ActivationAuditLog : "tracked by"
    
    CustomerDocument ||--o{ DocumentValidation : "validated by"
    RegulatoryRule ||--o{ DocumentValidation : "applies to"
    
    SimActivationService ..> Customer : "uses"
    SimActivationService ..> SimCard : "uses"
    SimActivationService ..> MobileNumber : "uses"
    SimActivationService ..> SimActivation : "manages"
    SimActivationService ..> DocumentValidationService : "depends on"
    SimActivationService ..> RegulatoryComplianceService : "depends on"
    SimActivationService ..> AuditService : "depends on"
    
    DocumentValidationService ..> CustomerDocument : "validates"
    DocumentValidationService ..> RegulatoryRule : "applies"
    DocumentValidationService ..> ValidationResult : "returns"
    
    RegulatoryComplianceService ..> RegulatoryRule : "uses"
    RegulatoryComplianceService ..> SimActivation : "checks"
    
    AuditService ..> ActivationAuditLog : "creates"
